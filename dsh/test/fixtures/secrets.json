{
  "parse_env_file": [
    {
      "name": "comments, quotes, and a line without =",
      "text": "# comment\n\nA = \"abc123\"\nB=7656\nnot a pair\n",
      "expected": {
        "A": "abc123",
        "B": "7656"
      }
    },
    {
      "name": "single quotes and empty value",
      "text": "A='x y'\nB=\n",
      "expected": {
        "A": "x y",
        "B": ""
      }
    }
  ],
