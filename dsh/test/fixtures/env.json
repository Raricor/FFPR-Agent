{
  "cases": [
    {
      "name": "empty",
      "text": "",
      "expected": {}
    },
    {
      "name": "blank and comments",
      "text": "\n  # comment\n\t\nA=1\n",
      "expected": {
        "A": "1"
      }
    },
    {
      "name": "no equals",
      "text": "JUST_A_WORD\nA=1\n",
      "expected": {
        "A": "1"
      }
    },
    {
      "name": "values are trimmed",
      "text": " A = 1 \nB=\t two words \t\n",
      "expected": {
        "A": "1",
        "B": "two words"
      }
    },
    {
      "name": "paired quotes",
      "text": "A=\" x y \"\nB='z'\nC=\"\"\n",
      "expected": {
        "A": " x y ",
        "B": "z",
        "C": ""
      }
    },
    {
      "name": "unpaired quotes are kept",
      "text": "A=\"x\nB=x'\nC=''\n",
      "expected": {
        "A": "\"x",
        "B": "x'",
        "C": ""
      }
    },
    {
      "name": "equals inside value",
      "text": "A=x=y=z\n",
      "expected": {
        "A": "x=y=z"
      }
    },
    {
      "name": "empty name and value",
      "text": "=orphan\nEMPTY=\n",
      "expected": {
        "": "orphan",
        "EMPTY": ""
      }
    },
    {
      "name": "duplicate keys keep the last value",
      "text": "A=1\nB=2\nA=3\n",
      "expected": {
        "A": "3",
        "B": "2"
      }
    },
    {
      "name": "CRLF and old Mac line endings",
      "text": "A=1\r\nB=2\rC=3\n",
      "expected": {
        "A": "1",
        "B": "2",
        "C": "3"
      }
    }
  ]
}
